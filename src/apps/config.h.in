#include <QObject>

// config.h.in platfrom plugin output
// set(DFM_PLUGIN_PATH) in cmake
// if setting new definition, please use:
//  #undef DFM_PLUGIN_PATH
//  #define DFM_PLUGIN_PATH xxx

// Stringify a macro's value for diagnostic messages.
#ifndef DFM_STRINGIFY
#    define DFM_STRINGIFY_IMPL(x) #x
#    define DFM_STRINGIFY(x) DFM_STRINGIFY_IMPL(x)
#endif

#ifndef DFM_BUILD_DIR
#   ifdef QT_DEBUG
#        define DFM_BUILD_DIR "${DFM_BUILD_DIR}"
#   else
#        define DFM_BUILD_DIR "/nonexistent"
#   endif
#else
#    pragma message("DFM_BUILD_DIR already defined: " DFM_STRINGIFY(DFM_BUILD_DIR))
#endif

#ifndef DFM_BUILD_PLUGIN_DIR
#   ifdef QT_DEBUG
#       define DFM_BUILD_PLUGIN_DIR "${DFM_BUILD_PLUGIN_DIR}"
#   else
#        define DFM_BUILD_PLUGIN_DIR "/nonexistent"
#   endif
#else
#    pragma message("DFM_BUILD_PLUGIN_DIR already defined: " DFM_STRINGIFY(DFM_BUILD_PLUGIN_DIR))
#endif

